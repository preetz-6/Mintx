# Mintx Server — Environment Config
# Copy to .env and fill in values

# ── Text-only LLM (used when no screenshot available) ──
# Default: Ollama local
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# ── Vision-Language Model (used when redacted screenshot is available) ──
# Default: Ollama local with LLaVA
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=llava:7b
VLM_API_KEY=ollama

# ── Cloud Provider Examples ──

# --- Together AI (text + vision) ---
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct-Turbo
# LLM_API_KEY=your_together_api_key
# VLM_BASE_URL=https://api.together.xyz/v1
# VLM_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo
# VLM_API_KEY=your_together_api_key

# --- Groq (text-only, fast) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-70b-versatile
# LLM_API_KEY=your_groq_api_key

# --- OpenRouter (wide model selection) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# LLM_API_KEY=your_openrouter_key
# VLM_BASE_URL=https://openrouter.ai/api/v1
